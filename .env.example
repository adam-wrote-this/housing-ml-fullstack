# -----------------------------
# Docker compose project options
# -----------------------------
# COMPOSE_PROJECT_NAME=housing-ml-fullstack

# -----------------------------
# Host port mapping (edit docker-compose.yml if changed)
# -----------------------------
NEXTJS_PORT=3000
ML_SERVICE_PORT=8000
PYTHON_BACKEND_PORT=8001
JAVA_BACKEND_PORT=8080

# -----------------------------
# Inter-service URLs (container network)
# -----------------------------
ML_SERVICE_URL=http://ml-service:8000
PYTHON_BACKEND_URL=http://app1-python:8001
JAVA_BACKEND_URL=http://app2-java:8080

# -----------------------------
# Frontend API base (Next.js rewrite prefixes)
# -----------------------------
NEXT_PUBLIC_PYTHON_API_BASE=/api/python
NEXT_PUBLIC_JAVA_API_BASE=/api/java
